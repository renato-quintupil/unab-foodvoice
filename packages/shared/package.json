{
  "name": "@foodvoice/shared",
  "version": "0.8.0",
  "private": true,
  "description": "Contratos de dominio de FoodVoice: enums, esquemas Zod, mensajes en español y máquina de estados del pedido (D-005)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
