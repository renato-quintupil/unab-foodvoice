# FoodVoice · variables de entorno
#
# Copiar a `.env` y completar. `.env` está en `.gitignore` y NUNCA se versiona
# (Principio V, FR-028). Este archivo no contiene ningún valor real.
#
# Si falta una variable obligatoria, el arranque falla nombrándola y termina con
# código distinto de cero. No hay arranque degradado ni valor de reserva.

# --- Obligatorias -----------------------------------------------------------

# Contraseña del usuario `foodvoice` en PostgreSQL.
POSTGRES_PASSWORD=

# Cadena de conexión que usa Prisma.
# En contenedores:      postgresql://foodvoice:<POSTGRES_PASSWORD>@postgres:5432/foodvoice
# En desarrollo local:  postgresql://foodvoice:<POSTGRES_PASSWORD>@localhost:5432/foodvoice
DATABASE_URL=

# Cómo alcanza `web` a `api`.
# En contenedores:      http://api:3001
# En desarrollo local:  http://localhost:3001
API_INTERNAL_URL=

# Correo del administrador semilla (FR-028).
ADMIN_SEED_EMAIL=

# Su contraseña, de 8 a 72 caracteres. Nunca tiene valor por defecto (D-010).
ADMIN_SEED_PASSWORD=

# --- Opcionales -------------------------------------------------------------

# Con `production`, la cookie `fv_session` se marca `Secure`.
NODE_ENV=development

# Puerto interno de `api`.
PORT_API=3001

# Puerto de `web`, el único publicado hacia el anfitrión.
PORT_WEB=3000

# Modo de recuperación de acceso administrativo (FR-036). Ver quickstart §2b.
# Nunca es el modo por defecto: exige la intervención deliberada de una persona.
ADMIN_SEED_RECOVER=false

# Ejecutar la semilla del administrador al arrancar el contenedor de `api`.
# En local se deja en `false` y la semilla se corre a mano (quickstart §2). Se
# activa en despliegues gestionados, donde no hay forma cómoda de ejecutar una
# orden suelta dentro del contenedor. Es idempotente: repetirla no cambia nada.
ADMIN_SEED_ON_BOOT=false

# Interfaz en la que escucha `api`. Vacío en local y en Docker Compose.
# Se fija a `::` en plataformas cuya red interna es solo IPv6 (Railway).
HOST_API=
