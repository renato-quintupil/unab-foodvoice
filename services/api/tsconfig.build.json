{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": "./src",
    // Sin caché incremental: la imagen se compila siempre desde cero, así que
    // no ahorra nada, y un `.tsbuildinfo` que llegara por descuido haría que
    // `tsc` no emitiera nada y la imagen quedara sin `dist/` — un fallo que
    // solo aparece al arrancar el contenedor y no delata su causa.
    "incremental": false
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist", "test", "prisma", "**/*.spec.ts"]
}
