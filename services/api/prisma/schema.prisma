// Esquema de datos de FoodVoice · E1 y E3 (data-model.md)
//
// Los nombres de tabla y de columna van en snake_case singular; los del cliente
// TypeScript, en camelCase. La correspondencia se declara con @map/@@map para
// que las consultas SQL a mano —la guía de validación, el disparador de
// inmutabilidad, el UPSERT del contador— usen los nombres del documento.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CLIENTE
  NEGOCIO
  REPARTIDOR
  ADMINISTRADOR
}

/// Los seis estados del Principio XII v2.0.0 (E2, D-035). `@map` en cada valor
/// porque `OrderStatus` quedó fijado en minúscula desde E1
/// (`OrderStatus.CREADO = 'creado'`) y así viaja en toda la superficie HTTP;
/// sin `@map`, Postgres almacenaría la etiqueta en mayúscula del identificador
/// de Prisma y cada comparación con el enum de `packages/shared` fallaría.
enum OrderStatus {
  CREADO              @map("creado")
  EN_PREPARACION      @map("en_preparacion")
  ASIGNADO_REPARTIDOR @map("asignado_repartidor")
  ENTREGADO           @map("entregado")
  CERRADO             @map("cerrado")
  RECHAZADO           @map("rechazado")
}

enum UserStatus {
  ACTIVO
  DESACTIVADO
}

enum AdminAction {
  CREAR
  EDITAR
  CAMBIAR_ROL
  DESACTIVAR
  REACTIVAR
  RESTABLECER_PASSWORD
  /// E8 · Controles y administración (HU-07, D-084). Sin `targetUserId`: la
  /// acción es sobre el servicio completo, no sobre un usuario.
  PAUSAR_SERVICIO
  REANUDAR_SERVICIO
}

/// Las dos preguntas fijas de clasificación (E3, FR-001, D-020).
///
/// Es un enum y no una tabla: no se crean, editan, desactivan ni reordenan desde
/// la aplicación. Una tabla permitiría que existieran cero o tres dimensiones,
/// estados que FR-001 prohíbe.
enum Dimension {
  TIPO_COMIDA
  PERFIL_SALUD
}

/// E6 · Búsqueda por voz. Canal de origen de una búsqueda — solo telemetría
/// (`search_log.channel`); nunca cambia el resultado de la búsqueda (FR-009).
enum SearchChannel {
  TEXT
  VOICE

  @@map("search_channel")
}

/// E6 · Búsqueda por voz. `SEARCH` resuelve una lista; `ADD` resuelve un único
/// producto candidato para HU-13, reutilizando el mismo endpoint (D-056).
enum SearchIntent {
  SEARCH
  ADD

  @@map("search_intent")
}

/// E6 · Búsqueda por voz. Resultado final de una búsqueda, para `search_log`
/// únicamente — no viaja al cliente HTTP tal cual (contracts/shared.md).
enum SearchOutcome {
  RESULTS
  CLARIFICATION
  NO_RESULTS
  /// Solo `intent = ADD`: se resolvió un único producto candidato.
  RESOLVED
  /// Solo `intent = ADD`: ningún candidato razonable.
  NOT_FOUND
  /// Timeout, JSON inválido tras el reintento, o error del proveedor (D-065).
  ERROR

  @@map("search_outcome")
}

/// Persona que accede a la plataforma. No hay borrado físico (RN-002):
/// `status = DESACTIVADO` conserva el historial asociado.
model User {
  id               String     @id @default(uuid()) @db.Uuid
  fullName         String     @map("full_name")
  /// `text` con UNIQUE, no `citext` (D-015). La normalización a minúsculas y
  /// sin espacios al borde la aplican los esquemas Zod compartidos, que son la
  /// única puerta de entrada de datos.
  email            String     @unique
  phone            String
  passwordHash     String     @map("password_hash")
  role             Role
  status           UserStatus @default(ACTIVO)
  /// Derivada de `normalizarBusqueda(full_name + ' ' + email)` (D-011).
  /// Cambiar esa función exige una migración que repueble esta columna.
  searchNormalized String     @map("search_normalized")
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions      Session[]
  auditActed    AdminAuditLog[] @relation("actor")
  auditTargeted AdminAuditLog[] @relation("target")

  /// E2 · Gestión de pedidos. Ninguna de las cuatro cambia la forma de `User`.
  cart                   Cart?
  addresses              Address[]
  orders                 Order[]
  orderStatusEventsActed OrderStatusEvent[] @relation("orderStatusActor")
  /// E5 · Reparto. Pedidos que este usuario tiene o tuvo asignados como
  /// repartidor — a lo sumo uno en `asignado_repartidor` a la vez (D-069).
  deliveryOrders         Order[]            @relation("deliveryUser")
  /// E8 · Controles y administración. A lo sumo una fila (`ServiceStatus` es
  /// singleton); se conserva por si el administrador que pausó se desactiva.
  servicePausedBy        ServiceStatus[]    @relation("servicePausedBy")

  @@index([searchNormalized], map: "user_search_normalized_idx")
  @@index([role, status], map: "user_role_status_idx")
  /// Orden por defecto del listado (D-016). El desempate por `id` es lo que
  /// hace el orden total: sin él un usuario puede aparecer en dos páginas.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "user_created_at_id_idx")
  @@map("user")
}

/// Vínculo temporal entre un usuario autenticado y su uso de la aplicación.
/// **Sin restricción de unicidad sobre `user_id`**: un usuario puede tener
/// varias sesiones vivas a la vez, en distintos navegadores (security CHK004).
model Session {
  id String @id @default(uuid()) @db.Uuid

  userId         String    @map("user_id") @db.Uuid
  /// Congelado al iniciar sesión (FR-011, D-007): el cambio de rol rige desde
  /// el próximo inicio de sesión, y ninguna sesión viva muta sus privilegios.
  role           Role
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// E6 · Búsqueda por voz. Telemetría de las búsquedas hechas en esta sesión.
  searchLogs SearchLog[]

  @@index([userId], map: "session_user_id_idx")
  @@map("session")
}

/// Contador de intentos fallidos y bloqueo temporal, asociado al **correo
/// ingresado**, exista o no una cuenta con él (FR-033, D-003).
///
/// **Ausencia deliberada de clave foránea hacia `user`**: si la tuviera, sería
/// imposible contar intentos sobre correos no registrados y el sistema
/// respondería distinto para una cuenta existente que para una inexistente,
/// filtrando exactamente lo que FR-008 prohíbe filtrar.
///
/// Sin índice sobre `locked_until`: se consulta siempre por el correo exacto.
model LoginAttemptControl {
  email       String    @id
  failedCount Int       @default(0) @map("failed_count")
  lockedUntil DateTime? @map("locked_until") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("login_attempt_control")
}

/// Bitácora de solo-agregar de las acciones de HU-09 (FR-034).
///
/// Los usuarios se registran **por referencia, nunca por copia**: no hay
/// ninguna columna con nombre, correo, teléfono ni valores anteriores. Su
/// inmutabilidad la impone un disparador declarado en la migración inicial, no
/// una convención de código. Sin índice sobre `target_user_id`: en v1 ninguna
/// consulta lo aprovecharía (data CHK032).
model AdminAuditLog {
  id           String      @id @default(uuid()) @db.Uuid
  actorUserId  String      @map("actor_user_id") @db.Uuid
  /// Nulable desde E8 (D-084): `PAUSAR_SERVICIO`/`REANUDAR_SERVICIO` no tienen
  /// un usuario objetivo — actúan sobre el servicio completo. Las seis
  /// acciones de E1 lo siguen escribiendo siempre.
  targetUserId String?     @map("target_user_id") @db.Uuid
  action       AdminAction
  /// Nueva en E8 (D-084). Solo la usa `PAUSAR_SERVICIO`; `NULL` en
  /// `REANUDAR_SERVICIO` y en las seis acciones de E1, que nunca la tuvieron.
  reason       String?     @map("reason")
  occurredAt   DateTime    @default(now()) @map("occurred_at") @db.Timestamptz(3)

  actor  User  @relation("actor", fields: [actorUserId], references: [id], onDelete: Restrict)
  target User? @relation("target", fields: [targetUserId], references: [id], onDelete: Restrict)

  @@map("admin_audit_log")
}

// ---------------------------------------------------------------------------
// E3 · Administración de menú (data-model.md de 002-administracion-menu-productos)
//
// Dos entidades nuevas. **Ninguna tabla de E1 cambia**: no se añade ninguna
// columna a `user`, `session`, `login_attempt_control` ni `admin_audit_log`.
//
// `price_tier` (Económico · Medio · Caro) **NO ESTÁ AQUÍ**: se deriva en cada
// consulta (FR-032, D-023); no hay columna ni tabla. Que no sea una entidad es
// la decisión de diseño central de HU-14 y no un detalle: un tramo persistido
// envejece con la inflación y obliga a recalcular todo el catálogo cada vez que
// cambia un precio.
// ---------------------------------------------------------------------------

/// Valor administrable de una dimensión (HU-14). No hay borrado físico
/// (RN-004): `active = false` la retira del uso conservando su contenido.
model Category {
  id             String    @id @default(uuid()) @db.Uuid
  /// No editable tras la creación (FR-006): cambiarla movería de golpe todos
  /// los productos clasificados con ella a otra pregunta distinta.
  dimension      Dimension
  name           String
  /// Derivada de `normalizarBusqueda(name)` (D-021).
  /// ⚠️ Cambiar esa función exige una migración que repueble esta columna.
  nameNormalized String    @map("name_normalized")
  /// El dato que hará funcionar la búsqueda por voz de E6 (FR-003, FR-039).
  description    String
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  productsAsFoodType      Product[] @relation("foodType")
  productsAsHealthProfile Product[] @relation("healthProfile")

  /// La unicidad es **por dimensión**, no global (FR-004, RN-014): expresa en
  /// una sola línea que «Saludable» pueda existir a la vez como tipo de comida
  /// y como perfil de salud (HU14-E05) y no dos veces dentro de la misma
  /// (HU14-E04). Alcanza también a las desactivadas.
  @@unique([dimension, nameNormalized], map: "category_dimension_name_normalized_key")
  /// Sirve al desplegable del alta y al filtro del cliente, que siempre piden
  /// las categorías activas de una dimensión.
  @@index([dimension, active], map: "category_dimension_active_idx")
  @@map("category")
}

/// Elemento del catálogo (HU-02). Nunca se borra (RN-004): un producto que
/// estuvo en un pedido debe seguir siendo legible en ese pedido para siempre.
model Product {
  id             String  @id @default(uuid()) @db.Uuid
  name           String
  /// Única en todo el catálogo, incluidos los dados de baja (RN-005), para que
  /// su reactivación sea siempre posible.
  nameNormalized String  @unique(map: "product_name_normalized_key") @map("name_normalized")
  description    String
  /// Informativo, nunca una declaración de alérgenos (RN-019, FR-017).
  /// Su ausencia **no** significa que el producto no contenga el ingrediente.
  ingredients    String?
  /// Entero en pesos chilenos. La restricción de rango se añade con SQL en la
  /// migración; Prisma no la expresa en el esquema (D-026).
  price          Int

  /// Exactamente una categoría por dimensión, **obligatoria** (RN-011, D-024).
  /// Que sean columnas y no una tabla de unión hace irrepresentable el estado
  /// que la regla prohíbe. Que cada una apunte a su propia dimensión lo
  /// comprueba el servicio: la clave foránea no puede expresarlo.
  foodTypeCategoryId      String   @map("food_type_category_id") @db.Uuid
  healthProfileCategoryId String   @map("health_profile_category_id") @db.Uuid
  foodTypeCategory        Category @relation("foodType", fields: [foodTypeCategoryId], references: [id], onDelete: Restrict)
  healthProfileCategory   Category @relation("healthProfile", fields: [healthProfileCategoryId], references: [id], onDelete: Restrict)

  /// Está en el menú.
  active    Boolean  @default(true)
  /// Se puede preparar ahora. Si es `false`, el producto **sigue visible**,
  /// marcado «Agotado», y no se puede pedir (FR-029).
  available Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// E2 · Gestión de pedidos.
  cartLines  CartLine[]
  orderLines OrderLine[]

  /// E6 · Búsqueda por voz. Relación implícita, sin tabla de unión propia
  /// (D-059): Prisma la administra sola. Ausencia = "no declarado", nunca
  /// "declarado que no cumple" (data-model.md).
  dietaryTags DietaryTag[] @relation("productDietaryTags")

  /// Toda consulta del menú filtra por ahí.
  @@index([active, available], map: "product_active_available_idx")
  /// Sirve a las dos consultas de corte de precio de D-023.
  @@index([price], map: "product_price_idx")
  /// Orden del listado de administración, que debe ser estable para que la
  /// paginación sea determinista (FR-023). El desempate por `id` lo hace total.
  @@index([createdAt(sort: Desc), id(sort: Desc)], map: "product_created_at_id_idx")
  /// El filtro por categoría y el conteo de bloqueadores de FR-007.
  @@index([foodTypeCategoryId], map: "product_food_type_category_id_idx")
  @@index([healthProfileCategoryId], map: "product_health_profile_category_id_idx")
  @@map("product")
}

// ---------------------------------------------------------------------------
// E2 · Gestión de pedidos (data-model.md de 003-gestion-pedidos)
//
// Seis tablas nuevas. Ninguna tabla de E1 ni de E3 cambia de forma; `user` y
// `product` solo ganan relaciones entrantes. Las restricciones que Prisma no
// expresa —CHECKs, el índice único parcial de dirección predeterminada y el
// trigger append-only de `order_status_event`— se agregan como SQL create-only
// en la migración (data-model.md § Restricciones SQL añadidas).
// ---------------------------------------------------------------------------

/// Uno por cliente, creado perezosamente al primer `POST /cart/lines` (D-046).
/// No expone endpoint de «crear»: nace con la primera línea.
model Cart {
  id     String @id @default(uuid()) @db.Uuid
  userId String @unique @map("user_id") @db.Uuid

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user  User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  lines CartLine[]

  @@map("cart")
}

/// `@@unique([cartId, productId])` es lo que hace FR-004 («sumar cantidad a la
/// línea existente») una operación de base de datos (`upsert`), no una
/// búsqueda-y-decide de la aplicación. No congela nombre ni precio (FR-006):
/// el DTO se construye uniendo contra el `Product` vigente en cada lectura.
///
/// `onDelete: Cascade` en `cartId` —a diferencia de todo lo demás en este
/// esquema— porque `CartLine` no es un registro histórico: cuando el carrito
/// se vacía o se consume al confirmar, sus líneas deben desaparecer con él.
model CartLine {
  id        String @id @default(uuid()) @db.Uuid
  cartId    String @map("cart_id") @db.Uuid
  productId String @map("product_id") @db.Uuid
  /// `CHECK (quantity >= 1)` en la migración.
  quantity  Int

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@unique([cartId, productId], map: "cart_line_cart_id_product_id_key")
  @@map("cart_line")
}

/// Dirección de entrega guardada por el cliente (HU-11). No hay borrado físico
/// de una que ya fue usada (RN-005): `active = false` la retira del uso
/// conservando su contenido; `usedInOrder` nunca vuelve a `false` (D-039).
model Address {
  id              String   @id @default(uuid()) @db.Uuid
  userId          String   @map("user_id") @db.Uuid
  /// 2–60 caracteres (Supuesto 2), validado en `packages/shared`.
  label           String
  /// `normalizarBusqueda(label)` (D-040). ⚠️ Cambiar esa función exige una
  /// migración que repueble esta columna.
  labelNormalized String   @map("label_normalized")
  /// 10–500 caracteres, saltos de línea permitidos (Supuesto 2).
  text            String
  isDefault       Boolean  @default(false) @map("is_default")
  active          Boolean  @default(true)
  usedInOrder     Boolean  @default(false) @map("used_in_order")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  /// Alcanza también a las desactivadas (D-040), mismo criterio que
  /// `product.nameNormalized` de E3.
  @@unique([userId, labelNormalized], map: "address_user_id_label_normalized_key")
  /// Sirve a la consulta de «direcciones activas para elegir al confirmar».
  @@index([userId, active], map: "address_user_id_active_idx")
  @@map("address")
}

/// Nace del carrito de un cliente. Nunca se edita tras confirmarse (FR-035,
/// RN-009), salvo las dos transiciones de estado que el rol `NEGOCIO`
/// dispara — las únicas dos escrituras posibles sobre una fila de `Order` en
/// toda la vida del producto hasta E5.
model Order {
  id              String      @id @default(uuid()) @db.Uuid
  userId          String      @map("user_id") @db.Uuid
  status          OrderStatus @default(CREADO)
  /// Snapshot del texto de la dirección elegida al confirmar (FR-023, RN-006).
  addressText     String      @map("address_text")
  /// `NULL` salvo cuando `status = 'rechazado'` (FR-033). La invariante
  /// `rejection_reason IS NOT NULL ↔ status = 'rechazado'` la garantiza el
  /// servicio, no un `CHECK`: acoplaría el esquema a un solo valor del enum de
  /// una forma que Prisma no modela limpiamente (mismo criterio que D-024 de
  /// E3 con la clasificación de dos categorías).
  rejectionReason String?     @map("rejection_reason")
  /// E5 · Reparto. `NULL` salvo cuando `status = 'asignado_repartidor'` — la
  /// invariante la garantiza el servicio, no un `CHECK` (mismo criterio que
  /// `rejection_reason`). Se limpia al soltar el pedido (FR-008, D-066).
  deliveryUserId  String?     @map("delivery_user_id") @db.Uuid
  assignedAt      DateTime?   @map("assigned_at") @db.Timestamptz(3)
  /// E7 · Cierre del servicio. `NULL` salvo cuando el pedido se cerró por un
  /// reclamo del cliente — mismo criterio de invariante aplicada por el
  /// servicio, no por `CHECK`, que ya usa `rejection_reason`.
  complaintReason String?     @map("complaint_reason")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict)
  deliveryUser User?              @relation("deliveryUser", fields: [deliveryUserId], references: [id], onDelete: Restrict)
  lines        OrderLine[]
  statusEvents OrderStatusEvent[]

  /// Sirve la bandeja combinada del negocio (D-043):
  /// `WHERE status IN ('creado', 'en_preparacion') ORDER BY created_at ASC, id ASC`.
  /// El desempate por `id` hace el orden total y evita que la paginación
  /// repita u omita filas si dos pedidos comparten marca de tiempo (FR-041).
  @@index([status, createdAt, id], map: "order_status_created_at_id_idx")
  /// El propio historial del cliente (`GET /orders`).
  @@index([userId, createdAt], map: "order_user_id_created_at_idx")
  /// E5 · Reparto. Sirve la lista de disponibles (`status = 'en_preparacion'
  /// AND delivery_user_id IS NULL`) y la búsqueda del pedido en curso de un
  /// repartidor (D-066).
  @@index([status, deliveryUserId], map: "order_status_delivery_user_id_idx")
  @@map("order")
}

/// Copias inmutables del producto tomadas al confirmar (FR-027) — a
/// diferencia de `CartLine`, que siempre refleja el catálogo vigente.
/// `onDelete: Restrict` en `orderId` (no `Cascade`): una línea de pedido es un
/// registro histórico que nunca se borra junto con nada, porque el pedido
/// tampoco se borra nunca.
model OrderLine {
  id           String @id @default(uuid()) @db.Uuid
  orderId      String @map("order_id") @db.Uuid
  productId    String @map("product_id") @db.Uuid
  productName  String @map("product_name")
  /// Entero en pesos chilenos, congelado (FR-027).
  productPrice Int    @map("product_price")
  /// `CHECK (quantity >= 1)` en la migración.
  quantity     Int

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Restrict)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId], map: "order_line_order_id_idx")
  @@map("order_line")
}

/// Entrada append-only del historial del pedido (D-047, Principio XII). E2 la
/// escribe en la misma transacción que crea o cambia el pedido (D-048), pero
/// no la expone mediante API ni DTO (D-050): E4 publicará su consulta.
model OrderStatusEvent {
  id              String       @id @default(uuid()) @db.Uuid
  orderId         String       @map("order_id") @db.Uuid
  /// `NULL` únicamente en el evento inicial.
  previousStatus  OrderStatus? @map("previous_status")
  /// `creado` en el evento inicial; luego el estado ganado por la transición.
  resultingStatus OrderStatus  @map("resulting_status")
  actorUserId     String       @map("actor_user_id") @db.Uuid
  /// Copia del rol efectivo de la sesión, no del rol actual del usuario: el
  /// historial conserva qué función ejercía el actor aunque su rol cambie.
  actorRole       Role         @map("actor_role")
  /// Nueva en E8 (D-082). `NULL` salvo cuando `actorRole = ADMINISTRADOR` y la
  /// entrada viene de forzar una transición o cerrar administrativamente
  /// (HU-07). Vive aquí y no en `Order` porque un mismo pedido puede recibir
  /// más de una intervención administrativa a lo largo de su vida.
  reason          String?      @map("reason")
  occurredAt      DateTime     @default(now()) @map("occurred_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actor User  @relation("orderStatusActor", fields: [actorUserId], references: [id], onDelete: Restrict)

  /// Deja preparado el orden estable de consulta de E4, sin exponerla en E2.
  @@index([orderId, occurredAt, id], map: "order_status_event_order_id_occurred_at_id_idx")
  @@map("order_status_event")
}

/// Estado operativo del servicio completo (E8, HU-07 Historia 3, D-085).
/// Fila única (`id = 'singleton'`, sembrada por la migración) — v1 es
/// mono-local, no hay "el negocio pausado" por usuario. `OrdersService`
/// y `ServiceStatusService` siempre leen y escriben por ese `id` fijo.
model ServiceStatus {
  id             String    @id @default("singleton")
  paused         Boolean   @default(false)
  pauseReason    String?   @map("pause_reason")
  pausedAt       DateTime? @map("paused_at") @db.Timestamptz(3)
  pausedByUserId String?   @map("paused_by_user_id") @db.Uuid

  pausedBy User? @relation("servicePausedBy", fields: [pausedByUserId], references: [id], onDelete: SetNull)

  @@map("service_status")
}

// ---------------------------------------------------------------------------
// E6 · Búsqueda por voz (data-model.md de 006-busqueda-por-voz)
//
// Dos tablas nuevas. Ninguna tabla de E1/E2/E3/E9 cambia de forma; `product` y
// `session` solo ganan relaciones entrantes.
// ---------------------------------------------------------------------------

/// Aptitud dietética (D-059). En v1, una única fila ("Vegano"), cargada por
/// semilla — sin pantalla de administración (Clarifications, spec.md,
/// 2026-08-23). El negocio solo marca o desmarca la aptitud en cada producto.
model DietaryTag {
  id   String @id @default(uuid()) @db.Uuid
  /// Único valor en v1: "Vegano".
  name String @unique(map: "dietary_tag_name_key")

  products Product[] @relation("productDietaryTags")

  @@map("dietary_tag")
}

/// Telemetría de `POST /menu/search` (D-060). **Nunca** contiene la frase del
/// cliente ni audio (FR-027, Clarifications) — solo lo necesario para medir el
/// SLO (SC-004) y el gasto (SC-007) sin acumular contenido semántico.
model SearchLog {
  id         String        @id @default(uuid()) @db.Uuid
  sessionId  String        @map("session_id") @db.Uuid
  channel    SearchChannel
  intent     SearchIntent
  outcome    SearchOutcome
  /// Tiempo total de la solicitud, incluida la reconsulta a PostgreSQL.
  latencyMs  Int           @map("latency_ms")
  /// `null` cuando `outcome = ERROR` antes de recibir respuesta del proveedor.
  tokensUsed Int?          @map("tokens_used")
  /// Identificador exacto del modelo usado, para comparar versiones (D-057).
  model      String
  /// `null` salvo `outcome = ERROR`. Código interno, no el mensaje del proveedor.
  errorCode  String?       @map("error_code")
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  session Session @relation(fields: [sessionId], references: [id], onDelete: Restrict)

  @@index([sessionId, createdAt], map: "search_log_session_id_created_at_idx")
  @@map("search_log")
}
